/* ==========================================
   ESTUDIANTE LAYOUT - RESPONSIVE DESIGN
   ========================================== */
.student-layout {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: transparent;
}

/* --- HEADER SUPERIOR (DESKTOP) --- */
.top-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 2rem;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(226, 232, 240, 0.9);
  position: sticky;
  top: 0;
  z-index: 50;
}

:root[data-theme='dark'] .top-header {
  background: rgba(15, 23, 42, 0.85);
  border-bottom-color: rgba(148, 163, 184, 0.15);
}

.brand {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.brand-logo {
  background: linear-gradient(135deg, #10b981 0%, #8b5cf6 100%);
  width: 40px;
  height: 40px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  color: white;
  box-shadow: 0 4px 10px rgba(139, 92, 246, 0.3);
}

.brand-info h2 {
  margin: 0;
  font-size: 1.1rem;
  font-weight: 800;
  color: var(--text-main, #0f172a);
}

:root[data-theme='dark'] .brand-info h2 { color: #f8fafc; }

.brand-info span {
  font-size: 0.7rem;
  color: #8b5cf6;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

/* --- NAVEGACIÓN DESKTOP --- */
.desktop-nav {
  display: flex;
  gap: 1.5rem;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  text-decoration: none;
  font-weight: 600;
  font-size: 0.95rem;
  color: #64748b;
  padding: 0.5rem 1rem;
  border-radius: 12px;
  transition: all 0.2s ease;
}

:root[data-theme='dark'] .nav-link { color: #94a3b8; }

.nav-link:hover {
  background: rgba(139, 92, 246, 0.1);
  color: #8b5cf6;
}

.nav-link.active {
  background: #8b5cf6;
  color: white;
  box-shadow: 0 4px 12px rgba(139, 92, 246, 0.25);
}

/* --- CONTENEDOR PRINCIPAL --- */
.main-content {
  flex: 1;
  display: flex;
  justify-content: center;
  padding: 2rem;
  padding-bottom: calc(2rem + var(--nav-bottom-height)); /* Espacio para barra móvil */
}

.content-wrapper {
  width: 100%;
  max-width: 1200px; 
}

/* --- NAVEGACIÓN INFERIOR (MÓVIL) --- */
.bottom-nav {
  display: none; 
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: var(--nav-bottom-height);
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: 1px solid rgba(226, 232, 240, 0.9);
  justify-content: space-around;
  align-items: center;
  z-index: 9999;
  padding-bottom: env(safe-area-inset-bottom);
}

:root[data-theme='dark'] .bottom-nav {
  background: rgba(15, 23, 42, 0.95);
  border-top-color: rgba(148, 163, 184, 0.15);
}

.bottom-nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.25rem;
  text-decoration: none;
  color: #94a3b8;
  font-size: 1.25rem;
  width: 100%;
  height: 100%;
  transition: color 0.2s;
}

.bottom-nav-item span {
  font-size: 0.7rem;
  font-weight: 600;
}

.bottom-nav-item.active {
  color: #8b5cf6;
}

/* ==========================================
   MEDIA QUERIES
   ========================================== */
@media (max-width: 768px) {
  .desktop-nav {
    display: none; 
  }

  .bottom-nav {
    display: flex; 
  }

  .top-header {
    padding: 0.75rem 1.25rem;
    justify-content: center; 
  }

  .main-content {
    padding: 1rem; 
    padding-bottom: calc(1rem + var(--nav-bottom-height) + env(safe-area-inset-bottom));
  }
}